<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The pages to try, space-separated: https://<a Mac's tailnet name>/#token=<its pairing token>.
	     Filled in at build time by install.sh from `npm run mobile:link -- --urls`:
	     this Mac first, then any listed in ~/.spaceterm/other-macs. -->
	<key>SpacetermURLs</key>
	<string>$(SPACETERM_URLS)</string>
	<key>SpacetermNativeVersion</key>
	<string>$(SPACETERM_NATIVE_VERSION)</string>
	<!-- Plain PNGs rather than an asset catalog: compiling a catalog needs an
	     iOS simulator runtime installed, an 8 GB download for one icon. -->
	<!-- Hands-free mode keeps listening for "Control" with the screen locked,
	     and while this phone holds Control the app stays awake to play its
	     voice, microphone or not (NativeMicrophone.swift). -->
	<!-- Location: an agent's request for the user's position can be answered
	     while the app runs in the background, with Always permission
	     (NativeLocation.swift). Only from a request to its answer. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60</string>
			</array>
		</dict>
	</dict>
</dict>
</plist>
